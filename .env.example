# ==============================================================================
# SmeltIQ Gate Entry Compliance System - Environment Variables
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Surepass API Configuration
# Set to 'true' to run with built-in mock scenarios (no API cost / offline testing)
SUREPASS_MOCK=true
SUREPASS_API_URL=https://api.surepass.io/api/v1/rc/rc-full
SUREPASS_API_TOKEN=your_surepass_bearer_token_here

# Supabase PostgreSQL Configuration
# If left blank, backend operates gracefully using high-fidelity in-memory persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supervisor Override PIN
SUPERVISOR_OVERRIDE_PIN=SUPER88

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
