# ==============================================================================
# SmeltIQ Gate Entry Compliance System - Environment Variables
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Surepass API Configuration
# Set to 'false' to query live Surepass RC-v2 Sandbox API
SUREPASS_MOCK=false
SUREPASS_BASE_URL=https://api.surepass.io/api/v1
SUREPASS_API_URL=https://api.surepass.io/api/v1/rc/rc-v2
SUREPASS_API_KEY=your_surepass_bearer_token_here

# Supabase PostgreSQL Configuration
# If left blank, backend operates gracefully using high-fidelity in-memory persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supervisor Override PIN
SUPERVISOR_OVERRIDE_PIN=SUPER88

# Frontend Configuration
# Local Development: http://localhost:8000/api/v1
# Production / Netlify: https://your-backend-api.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# CORS Allowed Origins (Comma-separated if configured via environment)
# Defaults include localhost, 127.0.0.1, and https://entryverification.netlify.app
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://entryverification.netlify.app"]
