# ==============================================================================
# SmeltIQ Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
# For Local Development:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# For Netlify / Cloud Production Deployment:
# Set this in your Netlify site environment variables to your deployed backend URL:
# VITE_API_BASE_URL=https://api.yourbackend.com/api/v1

# Optional Supabase Integration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
