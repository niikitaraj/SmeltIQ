# ==============================================================================
# SmeltIQ Gate Entry Compliance System - Environment Variables
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Surepass API Configuration
# Set to 'false' to query live Surepass RC-v2 Sandbox API
SUREPASS_MOCK=false
SUREPASS_BASE_URL=https://sandbox.surepass.app/api/v1
SUREPASS_API_URL=https://sandbox.surepass.app/api/v1/rc/rc-v2
SUREPASS_SANDBOX_TOKEN=your_surepass_bearer_token_here

# Supabase PostgreSQL Configuration
# If left blank, backend operates gracefully using high-fidelity in-memory persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supervisor Override PIN
SUPERVISOR_OVERRIDE_PIN=SUPER88

# Frontend Configuration
VITE_API_BASE_URL=https://smeltiq-3.onrender.com/
