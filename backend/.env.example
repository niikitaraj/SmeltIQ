# SmeltIQ Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Surepass API Configuration
SUREPASS_API_URL=https://api.surepass.io/api/v1/rc/rc-full
SUREPASS_API_TOKEN=your_surepass_bearer_token_here
# Set to true for mock testing without incurring Surepass API costs
SUREPASS_MOCK=true

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security & Override Configuration
SUPERVISOR_OVERRIDE_PIN=SUPER88
