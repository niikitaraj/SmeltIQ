# SmeltIQ Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Surepass API Configuration
SUREPASS_BASE_URL=https://sandbox.surepass.app/api/v1
SUREPASS_API_URL=https://sandbox.surepass.app/api/v1/rc/rc-v2
SUREPASS_SANDBOX_TOKEN=your_surepass_bearer_token_here
# Set to false to directly proxy live Surepass Sandbox API calls
SUREPASS_MOCK=false

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security & Override Configuration
SUPERVISOR_OVERRIDE_PIN=SUPER88
